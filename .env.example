# LiveKit server base URL (e.g. wss://your-livekit-server)
LIVEKIT_URL=
# Token service endpoint used to retrieve participant tokens
TOKEN_SERVER_URL=http://localhost:5000/get_token
# Default room and identity used by the CLI
ROOM_NAME=
PARTICIPANT_IDENTITY=

# Optional audio device overrides
INPUT_DEVICE=
OUTPUT_DEVICE=

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Audio pipeline settings
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=1

# Optional overrides for IPC paths
IPC_SOCKET_PATH=/tmp/livekit_client.sock
PID_FILE_PATH=/tmp/livekit_client.pid
